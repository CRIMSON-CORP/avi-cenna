# Copy to .env.local for development, or set these on the VPS for production.
# Never commit the filled-in version — .gitignore keeps every .env* except
# this template out of the repository.

# ---------------------------------------------------------------- MAIL ----
# The school's existing mail host. We sign in to a mailbox that already lives
# there and ask it to send; we are a client, not a mail server. Do not point
# this at localhost — mail leaving this machine directly would fail the
# domain's SPF check and land in spam.
#
# avi-cenna.com currently delivers to mail.avi-cenna.com, and its SPF record
# authorises that host. If the school ever moves to Google Workspace or
# Microsoft 365, only these four lines change.

SMTP_HOST=mail.avi-cenna.com

# 465 for implicit TLS, 587 for STARTTLS. The code turns TLS on for 465 and
# negotiates it for anything else, so there is no separate "secure" flag.
SMTP_PORT=465

# The mailbox that sends. On a cPanel host this is the address and its
# ordinary mailbox password; on Google or Microsoft it is an app password.
# Every email the site sends will come FROM this address — a mail host will
# not let an account send as anyone else.
SMTP_USER=career@avi-cenna.com
SMTP_PASS=

# Optional. The display name beside the From address in an inbox.
# Defaults to the school's full name.
MAIL_FROM_NAME=Avi-Cenna Careers

# Optional. Where job applications are delivered. Defaults to the address
# already advertised on /careers, so the form works before this is set.
# Change it here to redirect applications without a deploy.
MAIL_TO_APPLICATIONS=career@avi-cenna.com

# ---------------------------------------------------------------- SITE ----
# Absolute base URL, used to build links inside emails — a mail client has no
# origin of its own to resolve a path against. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://avi-cenna.com
