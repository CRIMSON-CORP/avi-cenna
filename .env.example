# Copy to .env.local for development, or set these on the VPS for production.
# Never commit the filled-in version — .gitignore keeps every .env* except
# this template out of the repository.

# ---------------------------------------------------------------- MAIL ----
# The school's existing mail host. We sign in to mailboxes that already live
# there and ask them to send; we are a client, not a mail server. Do not point
# this at localhost — mail leaving this machine directly would fail the
# domain's SPF check and land in spam.
#
# avi-cenna.com currently delivers to mail.avi-cenna.com, and its SPF record
# authorises that host. All three mailboxes below live on it, so the host and
# port are shared and only the credentials differ.

SMTP_HOST=mail.avi-cenna.com

# 465 for implicit TLS, 587 for STARTTLS. The code turns TLS on for 465 and
# negotiates it for anything else, so there is no separate "secure" flag.
SMTP_PORT=465

# ------------------------------------------------------------ MAILBOXES ----
# One per form, because a mail host only lets an account send as itself. The
# From address on a message is decided by which account signed in, so sending
# a visit confirmation as bookavisit@ means signing in as bookavisit@.
#
# On a cPanel host each password is the mailbox's ordinary password, set in
# the control panel — not a Google/Microsoft app password.
#
# Transports are built on first use, so a mailbox with no password set costs
# nothing until a form needs it. Careers keeps working while visits waits.
#
# _NAME is optional: the display name beside the address in an inbox.

MAILBOX_CAREERS_USER=career@avi-cenna.com
MAILBOX_CAREERS_PASS=
MAILBOX_CAREERS_NAME=Avi-Cenna Careers

MAILBOX_VISITS_USER=bookavisit@avi-cenna.com
MAILBOX_VISITS_PASS=
MAILBOX_VISITS_NAME=Avi-Cenna Admissions

MAILBOX_ENQUIRIES_USER=info@avi-cenna.com
MAILBOX_ENQUIRIES_PASS=
MAILBOX_ENQUIRIES_NAME=Avi-Cenna International School

# ----------------------------------------------------------- RECIPIENTS ----
# Where each form is DELIVERED, as opposed to who sends it. All optional —
# each falls back to the address the site already shows the public, so the
# forms work before any of these are set. Change one to redirect a form
# without a deploy.

# MAIL_TO_APPLICATIONS=career@avi-cenna.com
# MAIL_TO_VISITS=bookavisit@avi-cenna.com
# MAIL_TO_ENQUIRIES=info@avi-cenna.com

# ---------------------------------------------------------------- SITE ----
# Absolute base URL, used to build links inside emails — a mail client has no
# origin of its own to resolve a path against. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://avi-cenna.com

